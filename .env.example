# Copy to .env and fill in. Never commit .env. Secrets are read only by the backend.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=npexplorer
POSTGRES_USER=npe
POSTGRES_PASSWORD=change-me
# Set automatically by docker-compose; set manually when running the API outside Docker:
# DATABASE_URL=postgresql+psycopg://npe:change-me@localhost:5432/npexplorer
DATABASE_URL=

# --- NPC-BERT inference service (optional) ---
NPC_BERT_API_URL=
NPC_BERT_API_KEY=
NPC_BERT_TIMEOUT_SECONDS=20

# --- External databases (official APIs) ---
ENABLE_REMOTE_ADAPTERS=false
PUBCHEM_API_KEY=
COCONUT_API_TOKEN=

# --- Caching & protection ---
REDIS_URL=
CACHE_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=262144
LOG_LEVEL=INFO
